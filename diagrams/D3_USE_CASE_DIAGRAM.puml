@startuml
title Use Case Diagram Menferse

left to right direction
skinparam packageStyle rectangle
skinparam shadowing false

actor "Mahasiswa" as M
actor "Administrator" as A

rectangle "Sistem Menferse" {

    package "Halaman Utama" {
        usecase "Melihat Menfess Publik" as UC1
    }

    package "Autentikasi" {
        usecase "Masuk ke Akun" as UC2
    }

    package "Pengelolaan Menfess" {
        usecase "Mengirim Menfess" as UC3
        usecase "Memilih Identitas Pengirim" as UC4
    }

    package "Moderasi Menfess" {
        usecase "Memoderasi Menfess" as UC5
        usecase "Menyetujui Menfess" as UC6
        usecase "Menolak Menfess" as UC7
    }

    package "Katalog dan Pemesanan Bunga" {
        usecase "Melihat Katalog Bunga" as UC8
        usecase "Memesan Bunga" as UC9
        usecase "Mengisi Data Penerima" as UC10
    }

    package "Status Pesanan" {
        usecase "Melihat Status Pesanan" as UC11
    }
}

' Asosiasi Mahasiswa
M -- UC1
M -- UC2
M -- UC3
M -- UC8
M -- UC9
M -- UC11

' Asosiasi Administrator
A -- UC5
A -- UC6
A -- UC7

' Relasi antar-use case
UC3 ..> UC4 : <<include>>
UC9 ..> UC10 : <<include>>

UC6 ..> UC5 : <<extend>>
UC7 ..> UC5 : <<extend>>

@enduml
